# 可选：把 API Key 放环境变量，而不是存进数据库
# 优先级高于界面里保存的配置。
# PAPER_AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# PAPER_AI_BASE_URL=https://api.deepseek.com/v1
# PAPER_AI_TEXT_MODEL=deepseek-flash
# PAPER_AI_VISION_MODEL=deepseek-flash

# 服务端口（默认 8787）
# PORT=8787

# 数据目录（默认 ./data），存放 SQLite、原始 PDF、裁切图
# PAPER_AI_DATA=D:\paper-ai-data

# 启动后自动打开浏览器
# PAPER_AI_OPEN=1
